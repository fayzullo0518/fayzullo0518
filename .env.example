# ===========================================================
#  Gold Med Nova — server sozlamalari
#
#  Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
#  `.env` hech qachon git'ga yoki arxivga qo'shilmasin.
# ===========================================================

# --- rejim ---------------------------------------------------
# production rejimida HTTPS majburiy, HSTS yoqiladi va
# JWT_SECRET bo'lmasa server umuman ishga tushmaydi.
NODE_ENV=production

# --- tarmoq --------------------------------------------------
PORT=5175
HOST=127.0.0.1

# nginx orqada turganda haqiqiy IP X-Forwarded-For dan olinadi.
# Bitta reverse proxy uchun 1, to'g'ridan-to'g'ri ochilsa 0.
# NOTO'G'RI qiymat rate limit'ni ishlamay qo'yadi: 0 bo'lsa hamma
# tashrifchi bitta IP ko'rinadi, katta son bo'lsa IP'ni soxtalashtirish
# mumkin bo'ladi. Render va Fly.io uchun 1.
TRUST_PROXY=1

# --- maxfiy kalit --------------------------------------------
# MAJBURIY. Kamida 32 belgi. Yangisini shu buyruq bilan yarating:
#   npm run secret
# Bu kalit o'zgarsa hamma sessiya bekor bo'ladi (bu — yaxshi).
JWT_SECRET=

# Sessiya muddati: 15m, 2h, 12h, 7d ...
TOKEN_TTL=12h

# --- birinchi administrator ----------------------------------
# Bazada hech kim bo'lmaganda shu hisob yaratiladi.
# ADMIN_PASSWORD bo'sh qoldirilsa server tasodifiy parol yaratadi va
# uni faqat BIR MARTA, ishga tushish jurnaliga chiqaradi.
# Parol kamida 12 belgi bo'lsin.
ADMIN_USERNAME=fayzullo
ADMIN_PASSWORD=
ADMIN_NAME=Fayzullo
ADMIN_EMAIL=fayzulloe17@gmail.com
ADMIN_PHONE=

# Hujjatdagi uchta hamkasb hisobi (SonYun, dilnoza, otabek) parolsiz
# yaratiladi — ular panelda parol berilgunga qadar kira olmaydi.
# Umuman kerak bo'lmasa: SEED_TEAM=0
SEED_TEAM=1

# Namuna so'rovlar bilan boshlansinmi (bo'sh dashboard o'rniga)
SEED_DEMO_DATA=1

# ===========================================================
#  MA'LUMOT QAYERDA SAQLANADI — eng muhim sozlama
#
#  Ikkitasidan BITTASINI albatta tanlang. Ikkalasi ham bo'sh
#  qolsa, server har qayta ishga tushganda kiritilgan hamma
#  ma'lumot yo'qoladi (bulutda bu har deploy'da sodir bo'ladi).
# ===========================================================

# --- variant A: tashqi Postgres (kartasiz bepul: neon.tech) ---
# Berilsa — baza ham, yuklangan fayllar ham shu yerda yotadi va
# server/konteyner o'chib yonsa ham tegilmaydi. Diski yo'q bepul
# hostlar (Koyeb, Railway, Render) uchun aynan shu kerak.
# DATABASE_URL=postgresql://user:parol@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- variant B: ulangan disk (Fly.io volume, VPS) -------------
# Postgres ishlatilmasa, baza va fayllar shu papkada yotadi.
# Bo'sh qoldirilsa server/data ishlatiladi — bu faqat o'z
# kompyuteringizda ishlatish uchun to'g'ri keladi.
# DATA_DIR=/data

# Bitta fayl uchun eng katta hajm (MB).
# Postgres bilan sukut bo'yicha 10, disk va S3 bilan 50.
# MAX_UPLOAD_MB=50

# ===========================================================
#  FAYLLAR UCHUN ALOHIDA ARZON OMBOR (ixtiyoriy)
#
#  Uskuna rasmlari va shartnomalar eng ko'p joy egallaydi, VPS
#  diski esa eng qimmat gigabayt. Bu sozlamalar berilsa, fayllar
#  asosiy serverda umuman saqlanmaydi — arzon omborga ketadi.
#  Baza va sayt asosiy serverda qoladi.
#
#  Ombor S3'ga mos bo'lishi kerak. Variantlar:
#    * MinIO — o'zingizning arzon ikkinchi serveringizda
#      (ma'lumot O'zbekistonda qoladi, qonun talabi bajariladi)
#    * Cloudflare R2 — 10 GB bepul, chiqish trafigi bepul
#    * Backblaze B2 — 10 GB bepul
# ===========================================================

# S3_BUCKET=goldmednova
# S3_ENDPOINT=https://ombor.sizning-domeningiz.uz
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=
# MinIO va o'z serveringiz uchun true, ba'zi xizmatlarda false
# S3_FORCE_PATH_STYLE=true

# --- fayllarni shifrlash -------------------------------------
# Berilsa, har bir fayl asosiy serverdan CHIQISHIDAN OLDIN
# AES-256-GCM bilan shifrlanadi. Kalit faqat shu yerda turadi,
# ya'ni ombor serveriga kirgan buzg'unchi o'qib bo'lmaydigan
# baytlarni topadi. Fayl o'zgartirilsa ham darrov bilinadi.
#
# Yarating:  npm run secret:files
#
# DIQQAT: kalit yo'qolsa fayllarni HECH KIM ocha olmaydi.
# FILE_ENCRYPTION_KEY=

# --- integratsiya --------------------------------------------
# Boshqa saytlar brauzeridan API'ga murojaat qilishi uchun
# ularning manzillarini vergul bilan ajratib yozing.
# Bo'sh qoldirilsa — faqat shu saytning o'zi murojaat qila oladi.
# ALLOWED_ORIGINS=https://medservis.uz,https://www.medservis.uz
ALLOWED_ORIGINS=

# --- HTTPS ---------------------------------------------------
# nginx / Render / Fly SSL'ni o'zi hal qilsa va ichkarida HTTP ishlasa,
# bu yerni false qiling — aks holda cheksiz redirect bo'ladi.
FORCE_HTTPS=true
