# Bu faylni .env ga nusxalab to'ldiring, yoki osonroq: npm run sozla

# ── MAJBURIY ───────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
LLM_XIZMATI=deepseek
LLM_MODEL=deepseek-chat
# Claude ishlatmoqchi bo'lsangiz:
#   LLM_XIZMATI=claude
#   ANTHROPIC_API_KEY=sk-ant-...
#   LLM_MODEL=claude-opus-5

# ── TELEGRAM (terminal rejimi uchun kerak emas) ────────────────────────────
# "npm run chat" faqat yuqoridagi kalit bilan ishlaydi.
TELEGRAM_BOT_TOKEN=
# Botga /id yozing, chiqqan raqamni shu yerga qo'ying.
OWNER_ID=

# ── OVOZLI XABAR (bittasi yetarli) ─────────────────────────────────────────
# DeepSeek'da ovozni matnga o'giradigan xizmat yo'q, shuning uchun alohida kerak.
# Hammasi bo'sh bo'lsa bot faqat yozma xabarni qabul qiladi.
#
# Groq — bepul limiti bor, whisper-large-v3:  console.groq.com
GROQ_API_KEY=
# OpenAI Whisper — pullik, ~0.006 $/daqiqa:   platform.openai.com
OPENAI_API_KEY=
# Deepgram — bepul boshlang'ich krediti bor:  console.deepgram.com
DEEPGRAM_API_KEY=
# Modelni o'zgartirish kerak bo'lsa (odatda shart emas):
# ASR_MODEL=whisper-large-v3-turbo
# Ovoz tili (Whisper turkcha bilan adashtirsa ham "uz" qoldiring):
# ASR_TIL=uz
# Turk imlosini o'zbek lotiniga o'girishni o'chirish: 0
# ASR_UZBEKLASHTIR=1
# Ovoz uchun tanish ismlar (botda /ismlar bilan ham qo'shiladi):
# ASR_ISMLAR=Sardorbek, Akmal Qodirov, Jasur
# Transkriptni model bilan o'zbekchaga keltirishni o'chirish: 0
# ASR_TOZALASH=1

# ── IXTIYORIY ──────────────────────────────────────────────────────────────
TIMEZONE=Asia/Tashkent
# Har kuni necha soatda eslatsin (0-23)
ESLATMA_SOATI=9
# Ovozdan yozilgan yozuv necha daqiqadan keyin o'zi tasdiqlanadi
TASDIQ_DAQIQA=10
VALYUTA=UZS
