# ── MAJBURIY ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=

# Botga /id yozing, chiqqan raqamni shu yerga qo'ying va qayta ishga tushiring.
OWNER_ID=

# ── OVOZLI XABAR UCHUN ─────────────────────────────────────────────────────
# DeepSeek'da ovozni matnga o'giradigan xizmat yo'q, shuning uchun bittasi kerak.
# Ikkalasi ham bo'sh bo'lsa bot faqat yozma xabarni qabul qiladi.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# ── IXTIYORIY ──────────────────────────────────────────────────────────────
# deepseek (sukut, DEEPSEEK_API_KEY bo'lsa) yoki claude (ANTHROPIC_API_KEY bilan)
LLM_XIZMATI=deepseek
# Claude ishlatmoqchi bo'lsangiz:
#   LLM_XIZMATI=claude
#   ANTHROPIC_API_KEY=sk-ant-...
#   LLM_MODEL=claude-opus-5
LLM_MODEL=deepseek-chat
TIMEZONE=Asia/Tashkent
# Har kuni necha soatda eslatsin (0-23)
ESLATMA_SOATI=9
# Ovozdan yozilgan yozuv necha daqiqadan keyin o'zi tasdiqlanadi
TASDIQ_DAQIQA=10
VALYUTA=UZS
