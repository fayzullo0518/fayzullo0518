# ── MAJBURIY ───────────────────────────────────────────────────────────────
# @BotFather dan olinadigan token
TELEGRAM_BOT_TOKEN=

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Sizning Telegram ID raqamingiz. Bo'sh qoldirsangiz, botga /id yozing —
# o'zi aytib beradi, keyin shu yerga qo'yasiz. Bot faqat shu odamga javob beradi.
OWNER_ID=

# ── OVOZLI XABAR UCHUN (bittasi) ───────────────────────────────────────────
# Ovozni matnga o'girish kaliti. Ikkalasi ham bo'sh bo'lsa, bot faqat
# yozma xabarlarni qabul qiladi (ovoz kelsa xushmuomala ogohlantiradi).
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# ── IXTIYORIY (sukut bo'yicha qiymatlari bor) ──────────────────────────────
CLAUDE_MODEL=claude-opus-5
# low | medium | high  — arzonroq/tezroq ishlashi uchun low qiling
CLAUDE_EFFORT=medium
TIMEZONE=Asia/Tashkent
# Har kuni necha soatda eslatsin (0-23)
ESLATMA_SOATI=9
VALYUTA=UZS
